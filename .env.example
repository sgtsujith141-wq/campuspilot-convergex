# CampusPilot — all variables are optional. The demo runs offline with none set.

# Controlled-demo routes (sample login, source-change simulator, scenario reset).
# Default: enabled. Set to "off" to disable them (they then return 404).
CAMPUSPILOT_DEMO_MODE=on

# SQLite file location. Default: ./.data/campuspilot.db (auto-created and seeded).
# CAMPUSPILOT_DB_PATH=./.data/campuspilot.db

# Local AI (Ollama running on this machine). See docs/AI_ARCHITECTURE.md.
# CAMPUSPILOT_LLM=on                              # "off" = keyword fallback only, clearly labelled
# CAMPUSPILOT_LLM_URL=http://127.0.0.1:11434      # must be a loopback http:// address
# CAMPUSPILOT_LLM_MODEL=llama3.2:1b               # any installed Ollama model
# CAMPUSPILOT_LLM_SUMMARY=off                     # "on" lets the model write a validated summary
